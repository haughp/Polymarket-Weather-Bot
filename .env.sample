# Signer: your MetaMask EOA private key
POLYMARKET_PRIVATE_KEY=0xYOUR_METAMASK_PRIVATE_KEY

# Funder: your Polymarket proxy wallet address from polymarket.com/settings
POLYMARKET_PROXY_WALLET_ADDRESS=0xYOUR_POLYMARKET_PROXY_WALLET

# MetaMask signer + Polymarket proxy wallet
USE_PROXY_WALLET=true
SIGNATURE_TYPE=2

ENTRY_THRESHOLD=0.15
EXIT_THRESHOLD=0.45
MAX_TRADES_PER_RUN=5
MIN_HOURS_TO_RESOLUTION=2
LOCATIONS="nyc,chicago,miami,dallas,seattle,atlanta"

# NOAA CDO API token — used by outcome_backfiller.py for US city ASOS readings.
# Free token, instant: https://www.ncdc.noaa.gov/cdo-web/token
# Without this, US cities fall back to Open-Meteo ERA5 (less accurate).
NOAA_CDO_TOKEN=YOUR_NOAA_CDO_TOKEN