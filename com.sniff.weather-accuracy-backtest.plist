    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/padraighaughey</string>
        <key>USER</key>
        <string>padraighaughey</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
