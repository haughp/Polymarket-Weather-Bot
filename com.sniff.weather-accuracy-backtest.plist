<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sniff.weather-accuracy-backtest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>forecast_accuracy_backtest.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/padraighaughey/Polymarket-Weather-Bot</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/weather_accuracy_backtest.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/weather_accuracy_backtest_err.log</string>
    <key>RunAtLoad</key>
